
import java.util.Scanner;

public class DNAPatternSearch {

    
    static int[] computeLPS(String pattern) {

        int m = pattern.length();
        int[] lps = new int[m];

        int len = 0;
        int i = 1;

        while (i < m) {

            if (pattern.charAt(i) == pattern.charAt(len)) {
                len++;
                lps[i] = len;
                i++;
            } else {
                if (len != 0) {
                    len = lps[len - 1];
                } else {
                    lps[i] = 0;
                    i++;
                }
            }
        }

        return lps;
    }

   
    static void KMPSearch(String dna, String pattern) {

        int n = dna.length();
        int m = pattern.length();

        int[] lps = computeLPS(pattern);

        int i = 0;
        int j = 0;
        int count = 0;

        while (i < n) {

            if (dna.charAt(i) == pattern.charAt(j)) {
                i++;
                j++;
            }

            if (j == m) {
                System.out.println(
                    "Pattern found at index: " + (i - j)
                );

                count++;
                j = lps[j - 1];

            } else if (i < n &&
                    dna.charAt(i) != pattern.charAt(j)) {

                if (j != 0) {
                    j = lps[j - 1];
                } else {
                    i++;
                }
            }
        }

        if (count == 0) {
            System.out.println("Pattern not found");
        } else {
            System.out.println("Total Occurrences: " + count);
        }
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.print("Enter DNA Sequence: ");
        String dna = sc.nextLine().toUpperCase();

        System.out.print("Enter DNA Pattern: ");
        String pattern = sc.nextLine().toUpperCase();

        if (dna.isEmpty() || pattern.isEmpty() ||
            !dna.matches("[ACGT]+") ||
            !pattern.matches("[ACGT]+")) {

            System.out.println("Invalid DNA input!");
        } else {
            KMPSearch(dna, pattern);
        }

        sc.close();
    }
}
