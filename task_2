
import java.util.*;
import java.util.stream.*;

public class RealTimeStreamAnalytics {

    public static void main(String[] args)
            throws InterruptedException {

        List<Integer> sensorData = new ArrayList<>();

        Random random = new Random();

        System.out.println("Real-Time Stream Analytics Engine");
        System.out.println("--------------------------------");

        
        for (int i = 1; i <= 10; i++) {

            int value = random.nextInt(100) + 1;
            sensorData.add(value);

            System.out.println("\nIncoming Data: " + value);

           
            List<Integer> filtered = sensorData.stream()
                    .filter(n -> n > 50)
                    .collect(Collectors.toList());

           
            double average = sensorData.stream()
                    .mapToInt(Integer::intValue)
                    .average()
                    .orElse(0);

            
            int maximum = sensorData.stream()
                    .mapToInt(Integer::intValue)
                    .max()
                    .orElse(0);

            
            long count = sensorData.stream()
                    .filter(n -> n > 50)
                    .count();

            System.out.println("Filtered Data: " + filtered);
            System.out.printf("Average: %.2f%n", average);
            System.out.println("Maximum: " + maximum);
            System.out.println("High Value Count: " + count);

            
            Thread.sleep(1000);
        }

        System.out.println("\nStream Processing Completed");
    }
}
